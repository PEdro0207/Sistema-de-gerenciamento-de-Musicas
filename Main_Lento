def fetch_songs_by_genre(genre_keyword, limit=100):
    """
    Função auxiliar para buscar músicas de um gênero no banco de dados.
    
    Args:
        genre_keyword (str): Palavra-chave do gênero (ex: 'rock', 'pop')
        limit (int): Número máximo de músicas a retornar
    
    Returns:
        list: Lista de dicionários com título, artista e duração formatada
    """
    songs_list = []
    try:
        database = get_db()
        cursor = database.cursor()

        # Busca um subconjunto maior para depois ordenar em memória 
        fetch_limit = max(limit * 50, 500)
        cursor.execute("""
            SELECT track_name, artist_name, popularity, formatted_duration
            FROM musicas
            WHERE LOWER(genre) LIKE ?
            LIMIT ?
        """, (f'%{genre_keyword}%', fetch_limit))

        rows = cursor.fetchall()

        for row in rows:
            songs_list.append({
                "title": row[0] or '',
                "artist": row[1] or '',
                "popularity": row[2] or 0,
                "tempo": row[3] or ''
            })

        # Ordena em memória usando BubbleSort para simular lentidão
        start_time = time.time()
        songs_list = bubble_sort(songs_list, lambda x: (-x['popularity'], x['artist'].lower(), x['title'].lower()))
        elapsed = time.time() - start_time
        print(f"⏱️  [LENTO] Ordenação por BubbleSort levou {elapsed:.4f}s para {len(songs_list)} itens")

        # Limita ao tamanho pedido
        songs_list = songs_list[:limit]
    except Exception as error:
        print(f"Erro ao buscar músicas de {genre_keyword}:", error)

    return songs_list


