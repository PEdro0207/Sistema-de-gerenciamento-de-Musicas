# ROTA DE BUSCA - Barra de pesquisa

@app.route('/search')
@measure_time
def search():
    """
    Endpoint de busca de músicas por título ou artista.
    
    Algoritmo: BUSCA LINEAR (O(n)) + BUBBLE SORT (O(n²)) — LENTO
    
    Estratégia:
    1. Carrega TODAS as músicas do banco de dados em memória
    2. Usa busca linear para filtrar resultados
    3. Usa bubble sort para ordenar por relevância
    
    Returns:
        JSON: Lista de até 8 músicas ordenadas por relevância
    
    Exemplo de requisição:
        GET /search?query=bohemian
    """
    search_query = request.args.get('query', '').strip()
    
    # Se a query está vazia, retorna resultado vazio
    if not search_query:
        return jsonify([])

    try:
        # Normaliza a query para comparação
        normalized_query = normalize_text(search_query)

        database = get_db()
        cursor = database.cursor()
        start_time = time.time()

        # Parâmetro opcional para forçar varredura completa (cuidado: MUITO LENTO)
        full_scan = request.args.get('full_scan', '0') in ('1', 'true', 'True')
        batch_size = 10000

        results = []

        if full_scan:
            print("⏱️  [LENTO-FULL] Iniciando varredura completa (fetchmany)...")
            cursor.execute("""
                SELECT track_name, artist_name, formatted_duration, normalized_track, normalized_artist
                FROM musicas
            """)
            total_loaded = 0
            scan_start = time.time()
            while True:
                rows = cursor.fetchmany(batch_size)
                if not rows:
                    break
                total_loaded += len(rows)
                for row in rows:
                    track_name, artist_name, formatted_duration, norm_track, norm_artist = row
                    if normalized_query in (norm_track or '') or normalized_query in (norm_artist or ''):
                        if (norm_track or '').startswith(normalized_query):
                            priority = 0
                        elif (norm_artist or '').startswith(normalized_query):
                            priority = 1
                        else:
                            priority = 2
                        results.append({
                            'title': track_name or '',
                            'artist': artist_name or '',
                            'tempo': formatted_duration or '',
                            'priority': priority,
                            'artist_name': artist_name or ''
                        })
            scan_time = time.time() - scan_start
            print(f"⏱️  [LENTO-FULL] Scan completo, carregadas {total_loaded} linhas em {scan_time:.4f}s")
        else:
            # Pré-filtra candidatos por SQL 
            print("⏱️  [LENTO] Usando pré-filtragem SQL para reduzir candidatos")
            cursor.execute("""
                SELECT track_name, artist_name, formatted_duration, normalized_track, normalized_artist
                FROM musicas
                WHERE normalized_track LIKE ? OR normalized_artist LIKE ?
                LIMIT 5000
            """, (f"%{normalized_query}%", f"%{normalized_query}%"))
            rows = cursor.fetchall()
            print(f"⏱️  [LENTO] SQL retornou {len(rows)} candidatos")
            # percorre o subset com busca linear
            for row in rows:
                track_name, artist_name, formatted_duration, norm_track, norm_artist = row
                if normalized_query in (norm_track or '') or normalized_query in (norm_artist or ''):
                    if (norm_track or '').startswith(normalized_query):
                        priority = 0
                    elif (norm_artist or '').startswith(normalized_query):
                        priority = 1
                    else:
                        priority = 2
                    results.append({
                        'title': track_name or '',
                        'artist': artist_name or '',
                        'tempo': formatted_duration or '',
                        'priority': priority,
                        'artist_name': artist_name or ''
                    })

        # Ordena resultados usando BubbleSort 
        sort_start = time.time()
        def multi_key_sort(item):
            return (item['priority'], item['artist_name'].lower(), item['title'].lower())
        results = bubble_sort(results, multi_key_sort)
        sort_elapsed = time.time() - sort_start
        print(f"⏱️  BubbleSort levou {sort_elapsed:.4f}s para ordenar {len(results)} itens (O(n²))")

        # Remove campos auxiliares e limita a 8 resultados
        final_results = []
        for r in results[:8]:
            final_results.append({
                'title': r['title'],
                'artist': r['artist'],
                'tempo': r['tempo']
            })

        total_time = time.time() - start_time
        print(f"⏱️  BUSCA TOTAL (LENTO): {total_time:.4f}s | {len(final_results)} resultados\n")

        return jsonify(final_results)

    except Exception as error:
        print(f"❌ Erro na busca: {error}")
        return jsonify([])


# Lista de playlists
@app.route('/playlists')
@measure_time
def playlists():
    playlists = []
    try:
        db = get_db()
        cursor = db.cursor()
        # Busca sem ORDER BY e ordena em memória via BubbleSort para simular lentidão
        cursor.execute("SELECT id, name, description, created_at FROM playlists")
        rows = cursor.fetchall()
        for row in rows:
            playlists.append({
                'id': row[0],
                'name': row[1] or '',
                'description': row[2] or '',
                'created_at': row[3] or ''
            })
        # Ordena em memória por created_at (BubbleSort)
        def playlist_key(p):
            return p.get('created_at') or ''
        playlists = bubble_sort(playlists, lambda x: playlist_key(x))
        playlists = list(reversed(playlists))
    except Exception as e:
        # tabela pode não existir ainda
        print('Erro ao listar playlists:', e)

    return render_template('playlists.html', playlists=playlists)


@app.route('/playlist/<int:playlist_id>')
def playlist_detail(playlist_id):
    try:
        db = get_db()
        cursor = db.cursor()
        cursor.execute('SELECT id, name, description, created_at FROM playlists WHERE id = ?', (playlist_id,))
        row = cursor.fetchone()
        if not row:
            abort(404)

        playlist = {
            'id': row[0],
            'name': row[1] or '',
            'description': row[2] or '',
            'created_at': row[3] or ''
        }

        # Buscar músicas da playlist via tabela playlist_tracks
        songs = []
        try:
            cursor.execute("""
                SELECT m.track_name, m.artist_name, m.formatted_duration, pt.id as track_id
                FROM playlist_tracks pt
                JOIN musicas m ON pt.music_id = m.rowid
                WHERE pt.playlist_id = ?
                ORDER BY pt.position ASC
            """, (playlist_id,))
            rows = cursor.fetchall()
            for row in rows:
                songs.append({
                    'title': row[0] or '',
                    'artist': row[1] or '',
                    'tempo': row[2] or '',
                    'track_id': row[3]
                })
        except Exception:
            # tabela playlist_tracks pode não existir ainda
            pass
        
        # Buscar playlists para o sidebar (ordenação em memória para demo lenta)
        playlists = []
        try:
            cursor.execute("SELECT id, name FROM playlists")
            rows = cursor.fetchall()
            for row in rows:
                playlists.append({'id': row[0], 'name': row[1] or ''})
            # Ordena em memória por nome (BubbleSort) para simular lentidão
            playlists = bubble_sort(playlists, lambda x: x['name'].lower())
        except Exception:
            pass
        
        return render_template('playlist_detail.html', playlist=playlist, songs=songs, playlists=playlists)
    except Exception as e:
        print('Erro ao carregar playlist:', e)
        abort(500)
    
# Criar playlist 
@app.route('/criar-playlist', methods=['GET', 'POST'])
def criar_playlist():
    success = False
    if request.method == 'POST':
        name = request.form.get('name', '').strip()
        description = request.form.get('description', '').strip()
        if name:
            try:
                db = get_db()
                cursor = db.cursor()

                # cria a tabela de playlists no SQL
                cursor.execute("""
                    CREATE TABLE IF NOT EXISTS playlists (
                        id INTEGER PRIMARY KEY AUTOINCREMENT,
                        name TEXT NOT NULL,
                        description TEXT,
                        created_at TEXT DEFAULT (datetime('now'))
                    )
                """)
                cursor.execute(
                    "INSERT INTO playlists (name, description) VALUES (?, ?)",
                    (name, description)
                )
                db.commit()
                
                # redireciona para evitar repost do form
                return redirect(request.path + "?success=1")
            except Exception as e:
                print("Erro ao criar playlist:", e)

    success = request.args.get('success') == '1'
    # Buscar playlists para exibir no sidebar (ordenação em memória para demo lenta)
    playlists = []
    try:
        db = get_db()
        cursor = db.cursor()
        cursor.execute("SELECT id, name FROM playlists")
        rows = cursor.fetchall()
        for row in rows:
            playlists.append({'id': row[0], 'name': row[1] or ''})
        playlists = bubble_sort(playlists, lambda x: x['name'].lower())
    except Exception:
        # tabela pode não existir ainda; ignorar
        pass

    return render_template('criar_playlist.html', success=success, playlists=playlists)


