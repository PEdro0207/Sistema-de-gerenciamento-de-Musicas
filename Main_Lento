def normalize_text(text_string):
    """
    Normaliza texto removendo acentos e convertendo para minúsculas.
    
    Utilizada para buscas case-insensitive e sem acentuação.
    
    Args:
        text_string (str): Texto a ser normalizado
    
    Returns:
        str: Texto normalizado
    
    Exemplo:
        normalize_text("José") → "jose"
    """
    if not text_string:
        return ""
    
    # Converte para minúsculas e remove espaços em branco
    text_string = str(text_string).lower().strip()
    
    # Normaliza caracteres acentuados 
    text_string = unicodedata.normalize('NFKD', text_string)
    
    text_string = ''.join(ch for ch in text_string if not unicodedata.combining(ch))
    
    return text_string


# Algoritmos lentos

def linear_search(items, key, key_extractor):
    """
    Busca linear (O(n)) — percorre cada elemento até encontrar.
    
    LENTO: Verifica cada elemento sequencialmente.
    
    Args:
        items: Lista de dicionários
        key: Chave a buscar
        key_extractor: Função para extrair a chave do item
    
    Returns:
        Lista de itens que contêm a chave
    """
    results = []
    for item in items:
        if key in key_extractor(item):
            results.append(item)
    return results


def bubble_sort(items, sort_key):
    """
    BubbleSort (O(n²)) — compara e troca elementos adjacentes repetidamente.
    
    LENTO: Faz muitas comparações e trocas desnecessárias.
    
    Args:
        items: Lista a ordenar
        sort_key: Função para extrair a chave de ordenação
    
    Returns:
        Lista ordenada
    """
    array = items.copy()
    n = len(array)
    
    # Percorre a lista n vezes
    for i in range(n):
        swapped = False
        # Compara e troca elementos adjacentes
        for j in range(0, n - i - 1):
            if sort_key(array[j]) > sort_key(array[j + 1]):
                # Troca
                array[j], array[j + 1] = array[j + 1], array[j]
                swapped = True
        # Se não houver trocas, a lista já está ordenada
        if not swapped:
            break
    
    return array


